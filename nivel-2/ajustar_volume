#!/usr/bin/env node 

import axios from "axios"
import fs from "fs"
import csv from "csv-parser"

// Get arguments from command line
const args = process.argv.slice(2);
const arquivoIndex = args.indexOf('--arquivo')
const placaIndex = args.indexOf('--placa')
const volumeIndex = args.indexOf('--volume')

// Validate arguments
if (arquivoIndex !== -1) {
  // CSV mode
  const arquivo = args[arquivoIndex + 1]
  
  // Read and process CSV file
  fs.createReadStream(arquivo)
    .pipe(csv())
    .on('data', async (row) => {
      try {
        const response = await axios.post('http://localhost:3000/api/dispositivos', {
          placa: row.placa,
          volume: parseInt(row.volume, 10)
        });
        console.log(`Volume ajustado para ${row.placa}:`, response.data)
      } catch (error) {
        console.error(`Erro para ${row.placa}:`, error.response?.data || error.message)
      }
    })
    .on('error', (error) => {
      console.error('Erro ao ler o arquivo:', error.message)
      process.exit(1)
    });
} else if (placaIndex !== -1 && volumeIndex !== -1) {
  // Single vehicle mode
  const placa = args[placaIndex + 1];
  const volume = parseInt(args[volumeIndex + 1], 10)

  axios.post('http://localhost:3000/api/dispositivos', {
    placa,
    volume
  })
  .then(response => {
    console.log('Volume ajustado com sucesso:', response.data)
  })
  .catch(error => {
    console.error('Erro ao ajustar volume:', error.response?.data || error.message)
    process.exit(1)
  });
} else {
  console.error('Uso:\n')
  console.error('Para arquivo CSV:')
  console.error('./ajustar_volume --arquivo <nome-do-arquivo.csv>')
  console.error('\nPara um veículo:')
  console.error('./ajustar_volume --placa <numero-da-placa> --volume <volume-de-0-a-100>')
  process.exit(1)
}